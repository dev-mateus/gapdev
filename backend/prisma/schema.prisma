generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String      @id @default(uuid())
  name     String
  email    String      @unique
  password String
  skills   UserSkill[]
  jobs     Job[]

  @@map("users")
}

enum SkillLevel {
  Beginner
  Basic
  Intermediate
  Advanced
  Specialist
}

enum SkillPriority {
  desirable
  required
}

enum JobLevel {
  Intern
  Junior
  MidLevel
  Senior
}

model UserSkill {
  id        String        @id @default(uuid())
  userId    String
  jobId     String        @map("job_id")
  skillName String
  level     SkillLevel    @default(Beginner)
  priority  SkillPriority @default(desirable)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("user_skills")
  @@index([userId])
  @@index([jobId])
}

model Job {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  companyName String      @map("company_name")
  jobTitle    String      @map("job_title")
  description String
  level       JobLevel    @default(Junior)
  compatibility Int       @default(0)
  createdAt   DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills     UserSkill[]

  @@map("jobs")
  @@index([userId])
}